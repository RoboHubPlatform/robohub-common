{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robohub.org/schemas/module/core.v1.json",
  "title": "The core of a RoboHub module manifest",
  "description": "What every module.yml says before its type says anything else. A type schema extends this one; the core is the identity and the facts every module has, and the type is what the module does.",
  "type": "object",
  "required": [
    "module"
  ],
  "properties": {
    "module": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s/]+$",
          "description": "The module's stable identity, prefixed by the repository and path it lives under, so two modules with the same name are two things."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string"
        },
        "import_path": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "maintainer": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "private"
          ]
        }
      },
      "additionalProperties": true
    },
    "main": {
      "type": "string"
    },
    "build": {
      "type": "object",
      "required": [
        "language"
      ],
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "c",
            "go",
            "cgo"
          ]
        }
      },
      "additionalProperties": true
    },
    "deps": {
      "type": "object"
    },
    "depends": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "docs": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    },
    "package": {
      "type": "object"
    },
    "config": {
      "type": "object"
    },
    "exports": {
      "type": "object"
    },
    "system_deps": {
      "type": "object"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "provides": {
      "type": "object"
    },
    "extends": {},
    "commands": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "serves": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sql": {
      "type": "object"
    },
    "platform": {
      "type": "string"
    },
    "vendor": {
      "type": "object"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "debug": {
      "type": "object"
    },
    "monitor": {
      "type": "object"
    },
    "bench": {
      "type": "object"
    },
    "mem": {
      "type": "object"
    },
    "testing": {
      "type": "object"
    },
    "tests": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
