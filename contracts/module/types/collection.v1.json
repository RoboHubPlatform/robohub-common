{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robohub.org/schemas/module/collection.v1.json",
  "title": "A collection of modules",
  "allOf": [
    {
      "$ref": "https://robohub.org/schemas/module/core.v1.json"
    },
    {
      "type": "object",
      "anyOf": [
        {
          "required": [
            "modules"
          ]
        },
        {
          "required": [
            "devices"
          ]
        },
        {
          "required": [
            "generate"
          ]
        }
      ],
      "properties": {
        "module": {
          "properties": {
            "type": {
              "const": "collection"
            }
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  ]
}
