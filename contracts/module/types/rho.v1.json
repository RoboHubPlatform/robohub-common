{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robohub.org/schemas/module/rho.v1.json",
  "title": "A Rho application or library",
  "allOf": [
    {
      "$ref": "https://robohub.org/schemas/module/core.v1.json"
    },
    {
      "type": "object",
      "required": [
        "main"
      ],
      "properties": {
        "module": {
          "properties": {
            "type": {
              "const": "rho"
            }
          }
        },
        "application": {
          "$ref": "https://robohub.org/schemas/module/defs.v1.json#/$defs/application"
        }
      }
    }
  ]
}
