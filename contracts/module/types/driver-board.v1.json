{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robohub.org/schemas/module/driver-board.v1.json",
  "title": "A driver board",
  "allOf": [
    {
      "$ref": "https://robohub.org/schemas/module/core.v1.json"
    },
    {
      "type": "object",
      "required": [
        "board",
        "build"
      ],
      "properties": {
        "module": {
          "properties": {
            "type": {
              "const": "driver-board"
            }
          }
        },
        "board": {
          "$ref": "https://robohub.org/schemas/module/defs.v1.json#/$defs/board"
        },
        "functions": {
          "$ref": "https://robohub.org/schemas/module/defs.v1.json#/$defs/functions"
        },
        "signals": {
          "$ref": "https://robohub.org/schemas/module/defs.v1.json#/$defs/signals"
        },
        "telemetry": {
          "$ref": "https://robohub.org/schemas/module/defs.v1.json#/$defs/telemetry"
        },
        "capabilities": {
          "$ref": "https://robohub.org/schemas/module/defs.v1.json#/$defs/capabilities"
        },
        "deployment": {
          "$ref": "https://robohub.org/schemas/module/defs.v1.json#/$defs/deployment"
        }
      }
    }
  ]
}
